# ─── Core (required in production) ────────────────────────────────────────────
# PostgreSQL connection string (Prisma + raw pg for the DingTalk tables).
DATABASE_URL=postgresql://workdash:CHANGE_ME@db:5432/workdash

# Absolute path (inside the container) to the Markdown vault root.
# In docker-compose this is the /vault mount of your host vault folder.
VAULT_PATH=/vault

# ─── Branding / domain (optional) ─────────────────────────────────────────────
# App display name shown in the header/sidebar/PWA manifest.
# APP_NAME=WorkDash
# Meeting-type options shown in meeting drawers. Comma-separated.
# MEETING_TYPES="General, 1:1, Team, Client, Interview, Review, Other"
# DEFAULT_MEETING_TYPE=General

# ─── Indexer (optional) ───────────────────────────────────────────────────────
# Set to 'false' to disable the vault file watcher.
# INDEXER_ENABLED=true
# INDEXER_DEBOUNCE_MS=500

# ─── Hermes chat integration ──────────────────────────────────────────────────
# URL of the Hermes dashboard gateway (WebSocket JSON-RPC + REST bootstrap).
HERMES_DASHBOARD_URL=http://127.0.0.1:9119
# Shared secret the dashboard sends as its session token to the gateway.
HERMES_DASHBOARD_SESSION_TOKEN=CHANGE_ME
# Same-origin base path the app uses to reach the Hermes SPA/APIs through a
# reverse proxy (default /hermes). The SPA itself is served by Hermes, not this app.
# HERMES_BASE_PATH=/hermes
# Shared secret for agent-facing write endpoints (falls back to the Hermes
# session token when unset).
# AGENT_API_TOKEN=

# ─── DingTalk chat integration ────────────────────────────────────────────────
# Path to the dws CLI binary mounted into the container.
# Install + authenticate on the HOST first: https://github.com/DingTalk-Real-AI/dingtalk-workspace-tool
DWS_PATH=/usr/local/bin/dws
# Your own DingTalk identity (shown as "me" in the chat UI). Optional but recommended.
# DINGTALK_SELF_OPEN_ID=
# DINGTALK_SELF_USER_ID=
# DINGTALK_SELF_NAME=
# Runtime cache dir for downloaded chat media.
# DINGTALK_MEDIA_DIR=/data/dingtalk-media

# ─── Calendar (optional — read-only CalDAV sync) ──────────────────────────────
# CALDAV_ENABLED=true
# DingTalk Calendar: https://calendar.dingtalk.com/dav/ (host-only values work too)
# CALDAV_URL=https://calendar.dingtalk.com/dav/
# CALDAV_USERNAME=
# CALDAV_PASSWORD=
# CALDAV_CALENDAR_URL=
# CALDAV_SYNC_INTERVAL_MS=3600000
# CALDAV_FETCH_TIMEOUT_MS=60000

# ─── Push notifications (optional) ────────────────────────────────────────────
# Generate: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# ─── External vault indexer — gbrain-style sync trigger (optional) ────────────
# When set, every vault write-back (kanban edits, meeting pipeline, project
# chat) POSTs to this URL so your indexer re-syncs promptly. Safe no-op when unset.
# GBRAIN_SYNC_HOOK_URL=http://host.docker.internal:9103/sync

# ─── Meetings: audio → structured note pipeline ───────────────────────────────
# S3-compatible storage for temp audio objects (required for audio uploads).
MEETING_S3_ENDPOINT=http://minio:9000
MEETING_S3_PUBLIC_BASE=http://localhost:9000
MEETING_S3_BUCKET=meeting-audio
MEETING_S3_REGION=us-east-1
MEETING_S3_ACCESS_KEY=
MEETING_S3_SECRET_KEY=
# MEETING_S3_PRESIGN_TTL=7200
# MEETING_AUDIO_MAX_BYTES=524288000

# Async transcription (DashScope filetrans).
QWEN_FILETRANS_BASE_URL=https://dashscope.aliyuncs.com/api/v1
QWEN_FILETRANS_MODEL=qwen3-asr-flash-filetrans
QWEN_ASR_API_KEY=
# QWEN_ASR_BASE_TIMEOUT_SEC=600
# QWEN_ASR_DURATION_FACTOR=1.4
# QWEN_ASR_MAX_TIMEOUT_SEC=14400
# MEETING_ASR_TRANSCODE_THRESHOLD=41943040
# MEETING_ASR_TRANSCODE_BITRATE=32

# Meeting-note LLM (OpenAI-compatible chat; also used by the project-note chat).
MEETING_LLM_PROVIDER=zai
MEETING_LLM_MODEL=glm-5
MEETING_LLM_API_KEY=
MEETING_LLM_BASE_URL=
# MEETING_LLM_TIMEOUT_SEC=900
# Light-tier model for cheap transforms (translation, task normalization).
# MEETING_LLM_LIGHT_PROVIDER=
# MEETING_LLM_LIGHT_MODEL=
# MEETING_LLM_LIGHT_BASE_URL=
# MEETING_LLM_LIGHT_API_KEY=
# ZAI_API_KEY=
# ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
# ZAI_MODEL=glm-5
# MIMO_API_KEY=
# MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
# MIMO_MODEL=mimo-v2.5-pro
# CSV of attendee names to improve metadata extraction.
# MEETING_KNOWN_PEOPLE=

# Format stage: 'code' (deterministic, default) or 'opencode' (formatter agents
# over HTTP, with code fallback).
# MEETING_FORMATTER=code
# opencode HTTP server (`opencode serve`) reachable from the container.
# OPENCODE_SERVER_URL=http://host.docker.internal:4096
# OPENCODE_SERVER_USERNAME=opencode
# OPENCODE_SERVER_PASSWORD=
# OPENCODE_TIMEOUT_SEC=900
# OPENCODE_FORMATTER_MODEL=
# OPENCODE_LINKER_MODEL=
# OPENCODE_PARSER_MODEL=
# JSON map of meeting type -> agent name for custom formatter agents.
# OPENCODE_AGENT_BY_TYPE=
# Vault root as seen by the OPENCODE HOST (defaults to VAULT_PATH).
# OPENCODE_VAULT_PATH=
# Run the read-only linker worker while MEETING_FORMATTER=code.
# MEETING_LINKER_ENABLED=false
# Entity-update application: off (default) | dry_run | apply.
# MEETING_ENTITY_UPDATES_MODE=off

# ─── Chat voice (optional — pipecat-voice sidecar) ────────────────────────────
# VOICE_LEASE_SECRET=CHANGE_ME
# QWEN_ASR_REALTIME_MODEL=qwen3-asr-flash-realtime
# QWEN_TTS_REALTIME_MODEL=qwen3-tts-flash-realtime
# QWEN_TTS_VOICE=Cherry
# (sidecar only) DASHSCOPE_API_KEY=
# QWEN_REALTIME_WS_BASE=wss://dashscope.aliyuncs.com/api-ws/v1/realtime

# ─── docker-compose conveniences ──────────────────────────────────────────────
# Host path of your Markdown vault (mounted at /vault).
# VAULT_HOST_PATH=/path/to/your/vault
# Host paths for the dws CLI + its auth state (mounted into the container).
# DWS_HOST_PATH=/home/you/.local/bin/dws
# DWS_CONFIG_HOST_PATH=/home/you/.dws
# DWS_DATA_HOST_PATH=/home/you/.local/share/dws-cli
# Built-in Postgres service credentials.
# POSTGRES_USER=workdash
# POSTGRES_PASSWORD=CHANGE_ME
# POSTGRES_DB=workdash
